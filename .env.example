# Local preview: npm start. No credentials are required for demo or crew play.
HOST=127.0.0.1
PORT=3000

# Optional Twitch installed-chat integration. Register a Twitch developer app,
# then obtain YOUR broadcaster's user access token for the same client ID.
# Required scope: user:read:chat. Optional replies: user:write:chat.
# Choose Create live mission, connect Twitch, then pair companions with !link.
# Rehearsal remains anonymous and cannot be switched to live.
# Never use a client secret or app access token here.
TWITCH_CLIENT_ID=
TWITCH_ACCESS_TOKEN=

# Optional exact public origin, e.g. https://heist.example.com, when using a proxy.
# Run HOST=0.0.0.0 behind an HTTPS reverse proxy for remote crew access.
PUBLIC_ORIGIN=
